{
  "name": "eth-graph-query",
  "version": "2.0.21",
  "description": "A lightweight GraphQL query builder and client with first-class support for The Graph. Build queries using JSON, avoid string concatenation, and keep strong TypeScript types.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run clear && tsc && vite build",
    "preview": "vite preview",
    "clear": "rm -rf dist",
    "test": "vitest run",
    "prepare": "bun run build && husky install",
    "eslint": "eslint --config ./eslint.config.js --cache",
    "format": "prettier --write .",
    "prepublishOnly": "bun run clear && bun run build && bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phamhongphuc1999/eth-graph-query.git"
  },
  "keywords": [
    "graphql",
    "ethereum"
  ],
  "author": "phamhongphuc1999",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/phamhongphuc1999/eth-graph-query/issues"
  },
  "homepage": "https://github.com/phamhongphuc1999/eth-graph-query#readme",
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@eslint/js": "^9.29.0",
    "@types/node": "^20.12.2",
    "eslint": "^9.29.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.6",
    "path": "^0.12.7",
    "typescript": "5.5.3",
    "typescript-eslint": "^8.34.1",
    "vite": "^7.2.7",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.15"
  },
  "contributors": [
    {
      "name": "Phạm Hồng Phúc",
      "email": "phamhongphuc12atm1@gmail.com",
      "url": "https://github.com/phamhongphuc1999"
    }
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
